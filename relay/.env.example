# Protect the LAN relay. Generate with: openssl rand -hex 32
RELAY_TOKEN=

# Amazon account region
AMAZON_PAGE=amazon.com
ALEXA_SERVICE_HOST=pitangui.amazon.com

# JSON object emitted by alexa-remote2 after Alexa authentication.
# Do not commit real credentials.
ALEXA_COOKIE_JSON=

# Optional default Echo device name or serial number.
ECHO_DEVICE=
VOLUME_STEP=10
PORT=8080
LOG_LEVEL=info
