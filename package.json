{
  "name": "echo-show-remote",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev": "eas build --profile development --platform all",
    "build:preview": "eas build --profile preview --platform all",
    "build:ios": "eas build --profile production-ios --platform ios",
    "build:android": "eas build --profile production-android --platform android",
    "submit:ios": "eas submit --profile production-ios --platform ios",
    "submit:android": "eas submit --profile production-android --platform android",
    "submit:all": "eas submit --profile production-ios --platform ios && eas submit --profile production-android --platform android",
    "lint": "expo lint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "expo-status-bar": "~1.12.1",
    "expo-screen-orientation": "~7.0.5",
    "expo-haptics": "~13.0.1",
    "expo-image-picker": "~15.0.7",
    "expo-linear-gradient": "~13.0.2",
    "expo-blur": "~13.0.2",
    "expo-font": "~12.0.9",
    "expo-splash-screen": "~0.27.5",
    "expo-keep-awake": "~13.0.2",
    "expo-network": "~6.0.1",
    "@expo/vector-icons": "^14.0.2",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/stack": "^6.3.29",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-gesture-handler": "~2.17.1",
    "react-native-reanimated": "~3.10.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@bam.tech/react-native-android-widget": "^0.8.0",
    "react-native-svg": "15.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.3.3",
    "eas-cli": "^10.0.0"
  },
  "private": true
}
